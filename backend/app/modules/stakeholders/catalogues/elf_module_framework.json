  "analysis_methods": [
    {
      "code": "power_interest",
      "name_key": "stakeholders.catalogue.method.power_interest",
      "version": 1,
      "dimensions": [
        {
          "code": "power",
          "name_key": "stakeholders.catalogue.dimension.power",
          "type": "int",
          "min": 1,
          "max": 5
        },
        {
          "code": "interest",
          "name_key": "stakeholders.catalogue.dimension.interest",
          "type": "int",
          "min": 1,
          "max": 5
        }
      ],
      "classes": [
        {
          "code": "manage_closely",
          "name_key": "stakeholders.catalogue.class.manage_closely"
        },
        {
          "code": "keep_satisfied",
          "name_key": "stakeholders.catalogue.class.keep_satisfied"
        },
        {
          "code": "keep_informed",
          "name_key": "stakeholders.catalogue.class.keep_informed"
        },
        {
          "code": "monitor",
          "name_key": "stakeholders.catalogue.class.monitor"
        }
      ],
      "rules": [
        {
          "when": {
            "power": {
              "gte": 3
            },
            "interest": {
              "gte": 3
            }
          },
          "classification": "manage_closely"
        },
        {
          "when": {
            "power": {
              "gte": 3
            }
          },
          "classification": "keep_satisfied"
        },
        {
          "when": {
            "interest": {
              "gte": 3
            }
          },
          "classification": "keep_informed"
        }
      ],
      "default": "monitor"
    },
    {
      "code": "salience",
      "name_key": "stakeholders.catalogue.method.salience",
      "version": 1,
      "dimensions": [
        {
          "code": "power",
          "name_key": "stakeholders.catalogue.dimension.power",
          "type": "bool"
        },
        {
          "code": "legitimacy",
          "name_key": "stakeholders.catalogue.dimension.legitimacy",
          "type": "bool"
        },
        {
          "code": "urgency",
          "name_key": "stakeholders.catalogue.dimension.urgency",
          "type": "bool"
        }
      ],
      "classes": [
        {
          "code": "definitive",
          "name_key": "stakeholders.catalogue.class.definitive"
        },
        {
          "code": "dominant",
          "name_key": "stakeholders.catalogue.class.dominant"
        },
        {
          "code": "dangerous",
          "name_key": "stakeholders.catalogue.class.dangerous"
        },
        {
          "code": "dependent",
          "name_key": "stakeholders.catalogue.class.dependent"
        },
        {
          "code": "dormant",
          "name_key": "stakeholders.catalogue.class.dormant"
        },
        {
          "code": "discretionary",
          "name_key": "stakeholders.catalogue.class.discretionary"
        },
        {
          "code": "demanding",
          "name_key": "stakeholders.catalogue.class.demanding"
        },
        {
          "code": "non_stakeholder",
          "name_key": "stakeholders.catalogue.class.non_stakeholder"
        }
      ],
      "rules": [
        {
          "when": {
            "power": {
              "eq": true
            },
            "legitimacy": {
              "eq": true
            },
            "urgency": {
              "eq": true
            }
          },
          "classification": "definitive"
        },
        {
          "when": {
            "power": {
              "eq": true
            },
            "legitimacy": {
              "eq": true
            }
          },
          "classification": "dominant"
        },
        {
          "when": {
            "power": {
              "eq": true
            },
            "urgency": {
              "eq": true
            }
          },
          "classification": "dangerous"
        },
        {
          "when": {
            "legitimacy": {
              "eq": true
            },
            "urgency": {
              "eq": true
            }
          },
          "classification": "dependent"
        },
        {
          "when": {
            "power": {
              "eq": true
            }
          },
          "classification": "dormant"
        },
        {
          "when": {
            "legitimacy": {
              "eq": true
            }
          },
          "classification": "discretionary"
        },
        {
          "when": {
            "urgency": {
              "eq": true
            }
          },
          "classification": "demanding"
        }
      ],
      "default": "non_stakeholder",
      "source_url": "https://www.jstor.org/stable/259247"
    },
    {
      "code": "engagement_level",
      "name_key": "stakeholders.catalogue.method.engagement_level",
      "version": 1,
      "dimensions": [
        {
          "code": "current",
          "name_key": "stakeholders.catalogue.dimension.current",
          "type": "int",
          "min": 0,
          "max": 4
        },
        {
          "code": "desired",
          "name_key": "stakeholders.catalogue.dimension.desired",
          "type": "int",
          "min": 0,
          "max": 4
        }
      ],
      "classes": [],
      "rules": [],
      "default": null
    },
    {
      "code": "attitude",
      "name_key": "stakeholders.catalogue.method.attitude",
      "version": 1,
      "dimensions": [
        {
          "code": "attitude",
          "name_key": "stakeholders.catalogue.dimension.attitude",
          "type": "int",
          "min": -2,
          "max": 2
        }
      ],
      "classes": [
        {
          "code": "supportive",
          "name_key": "stakeholders.catalogue.class.supportive"
        },
        {
          "code": "neutral",
          "name_key": "stakeholders.catalogue.class.neutral"
        },
        {
          "code": "resistant",
          "name_key": "stakeholders.catalogue.class.resistant"
        }
      ],
      "rules": [
        {
          "when": {
            "attitude": {
              "gte": 1
            }
          },
          "classification": "supportive"
        },
        {
          "when": {
            "attitude": {
              "lte": -1
            }
          },
          "classification": "resistant"
        }
      ],
      "default": "neutral"
    },
    {
      "code": "influence",
      "name_key": "stakeholders.catalogue.method.influence",
      "version": 1,
      "dimensions": [
        {
          "code": "influence",
          "name_key": "stakeholders.catalogue.dimension.influence",
          "type": "int",
          "min": 1,
          "max": 5
        }
      ],
      "classes": [
        {
          "code": "high",
          "name_key": "stakeholders.catalogue.class.high"
        },
        {
          "code": "medium",
          "name_key": "stakeholders.catalogue.class.medium"
        },
        {
          "code": "low",
          "name_key": "stakeholders.catalogue.class.low"
        }
      ],
      "rules": [
        {
          "when": {
            "influence": {
              "gte": 4
            }
          },
          "classification": "high"
        },
        {
          "when": {
            "influence": {
              "gte": 2
            }
          },
          "classification": "medium"
        }
      ],
      "default": "low"
    }
