            "en": "Desired level",
            "de": "Angestrebtes Niveau"
          }
        }
      ],
      "classes": [],
      "rules": [],
      "default": null,
      "labels": {
        "en": "Engagement level",
        "de": "Engagementniveau"
      }
    },
    {
      "code": "attitude",
      "name_key": "stakeholders.catalogue.method.attitude",
      "version": 1,
      "dimensions": [
        {
          "code": "attitude",
          "name_key": "stakeholders.catalogue.dimension.attitude",
          "type": "int",
          "min": -2,
          "max": 2,
          "labels": {
            "en": "Attitude",
            "de": "Haltung"
          }
        }
      ],
      "classes": [
        {
          "code": "supportive",
          "name_key": "stakeholders.catalogue.class.supportive",
          "labels": {
            "en": "Supportive",
            "de": "Unterstützend"
          }
        },
        {
          "code": "neutral",
          "name_key": "stakeholders.catalogue.class.neutral",
          "labels": {
            "en": "Neutral",
            "de": "Neutral"
          }
        },
        {
          "code": "resistant",
          "name_key": "stakeholders.catalogue.class.resistant",
          "labels": {
            "en": "Resistant",
            "de": "Ablehnend"
          }
        }
      ],
      "rules": [
        {
          "when": {
            "attitude": {
              "gte": 1
            }
          },
          "classification": "supportive"
        },
        {
          "when": {
            "attitude": {
              "lte": -1
            }
          },
          "classification": "resistant"
        }
      ],
      "default": "neutral",
      "labels": {
        "en": "Attitude",
        "de": "Haltung"
      }
    },
    {
      "code": "influence",
      "name_key": "stakeholders.catalogue.method.influence",
      "version": 1,
      "dimensions": [
        {
          "code": "influence",
          "name_key": "stakeholders.catalogue.dimension.influence",
          "type": "int",
          "min": 1,
          "max": 5,
          "labels": {
            "en": "Influence",
            "de": "Einfluss"
          }
        }
      ],
      "classes": [
        {
          "code": "high",
          "name_key": "stakeholders.catalogue.class.high",
          "labels": {
            "en": "High",
            "de": "Hoch"
          }
        },
        {
          "code": "medium",
          "name_key": "stakeholders.catalogue.class.medium",
          "labels": {
            "en": "Medium",
            "de": "Mittel"
          }
        },
        {
          "code": "low",
          "name_key": "stakeholders.catalogue.class.low",
          "labels": {
            "en": "Low",
            "de": "Niedrig"
          }
        }
      ],
      "rules": [
        {
          "when": {
            "influence": {
              "gte": 4
            }
          },
          "classification": "high"
        },
        {
          "when": {
            "influence": {
              "gte": 2
            }
          },
          "classification": "medium"
        }
      ],
      "default": "low",
      "labels": {
        "en": "Influence",
        "de": "Einfluss"
      }
    }
