  "analysis_methods": [
    {
      "code": "power_interest",
      "name_key": "stakeholders.catalogue.method.power_interest",
      "version": 1,
      "dimensions": [
        {
          "code": "power",
          "name_key": "stakeholders.catalogue.dimension.power",
          "type": "int",
          "min": 1,
          "max": 5,
          "labels": {
            "en": "Power",
            "de": "Macht"
          }
        },
        {
          "code": "interest",
          "name_key": "stakeholders.catalogue.dimension.interest",
          "type": "int",
          "min": 1,
          "max": 5,
          "labels": {
            "en": "Interest",
            "de": "Interesse"
          }
        }
      ],
      "classes": [
        {
          "code": "manage_closely",
          "name_key": "stakeholders.catalogue.class.manage_closely",
          "labels": {
            "en": "Manage closely",
            "de": "Eng einbinden"
          }
        },
        {
          "code": "keep_satisfied",
          "name_key": "stakeholders.catalogue.class.keep_satisfied",
          "labels": {
            "en": "Keep satisfied",
            "de": "Zufriedenstellen"
          }
        },
        {
          "code": "keep_informed",
          "name_key": "stakeholders.catalogue.class.keep_informed",
          "labels": {
            "en": "Keep informed",
            "de": "Informiert halten"
          }
        },
        {
          "code": "monitor",
          "name_key": "stakeholders.catalogue.class.monitor",
          "labels": {
            "en": "Monitor",
            "de": "Beobachten"
          }
        }
      ],
      "rules": [
        {
          "when": {
            "power": {
              "gte": 3
            },
            "interest": {
              "gte": 3
            }
          },
          "classification": "manage_closely"
        },
        {
          "when": {
            "power": {
              "gte": 3
            }
          },
          "classification": "keep_satisfied"
        },
        {
          "when": {
            "interest": {
              "gte": 3
            }
          },
          "classification": "keep_informed"
        }
      ],
      "default": "monitor",
      "labels": {
        "en": "Power and interest grid",
        "de": "Macht-Interesse-Matrix"
      }
    },
    {
      "code": "salience",
      "name_key": "stakeholders.catalogue.method.salience",
      "version": 1,
      "dimensions": [
        {
          "code": "power",
          "name_key": "stakeholders.catalogue.dimension.power",
          "type": "bool",
          "labels": {
            "en": "Power",
            "de": "Macht"
          }
        },
        {
          "code": "legitimacy",
          "name_key": "stakeholders.catalogue.dimension.legitimacy",
          "type": "bool",
          "labels": {
            "en": "Legitimacy",
            "de": "Legitimität"
          }
        },
        {
          "code": "urgency",
          "name_key": "stakeholders.catalogue.dimension.urgency",
          "type": "bool",
          "labels": {
            "en": "Urgency",
            "de": "Dringlichkeit"
          }
        }
      ],
      "classes": [
        {
          "code": "definitive",
          "name_key": "stakeholders.catalogue.class.definitive",
          "labels": {
            "en": "Definitive",
            "de": "Definitiv"
          }
        },
        {
          "code": "dominant",
          "name_key": "stakeholders.catalogue.class.dominant",
          "labels": {
            "en": "Dominant",
            "de": "Dominant"
          }
        },
        {
          "code": "dangerous",
          "name_key": "stakeholders.catalogue.class.dangerous",
          "labels": {
            "en": "Dangerous",
            "de": "Gefährlich"
          }
        },
        {
          "code": "dependent",
          "name_key": "stakeholders.catalogue.class.dependent",
          "labels": {
            "en": "Dependent",
            "de": "Abhängig"
          }
        },
        {
          "code": "dormant",
          "name_key": "stakeholders.catalogue.class.dormant",
          "labels": {
            "en": "Dormant",
            "de": "Ruhend"
          }
        },
        {
          "code": "discretionary",
          "name_key": "stakeholders.catalogue.class.discretionary",
          "labels": {
            "en": "Discretionary",
            "de": "Ermessensabhängig"
          }
        },
        {
          "code": "demanding",
          "name_key": "stakeholders.catalogue.class.demanding",
          "labels": {
            "en": "Demanding",
            "de": "Fordernd"
          }
        },
        {
          "code": "non_stakeholder",
          "name_key": "stakeholders.catalogue.class.non_stakeholder",
          "labels": {
            "en": "Not a stakeholder",
            "de": "Kein Stakeholder"
          }
        }
      ],
      "rules": [
        {
          "when": {
            "power": {
              "eq": true
            },
            "legitimacy": {
              "eq": true
            },
            "urgency": {
              "eq": true
            }
          },
          "classification": "definitive"
        },
        {
          "when": {
            "power": {
              "eq": true
            },
            "legitimacy": {
              "eq": true
            }
          },
          "classification": "dominant"
        },
        {
          "when": {
            "power": {
              "eq": true
            },
            "urgency": {
              "eq": true
            }
          },
          "classification": "dangerous"
        },
        {
          "when": {
            "legitimacy": {
              "eq": true
            },
            "urgency": {
              "eq": true
            }
          },
          "classification": "dependent"
        },
        {
          "when": {
            "power": {
              "eq": true
            }
          },
          "classification": "dormant"
        },
        {
          "when": {
            "legitimacy": {
              "eq": true
            }
          },
          "classification": "discretionary"
        },
        {
          "when": {
            "urgency": {
              "eq": true
            }
          },
          "classification": "demanding"
        }
      ],
      "default": "non_stakeholder",
      "source_url": "https://www.jstor.org/stable/259247",
      "labels": {
        "en": "Salience model",
        "de": "Salienzmodell"
      }
    },
    {
      "code": "engagement_level",
      "name_key": "stakeholders.catalogue.method.engagement_level",
      "version": 1,
      "dimensions": [
        {
          "code": "current",
          "name_key": "stakeholders.catalogue.dimension.current",
          "type": "int",
          "min": 0,
          "max": 4,
