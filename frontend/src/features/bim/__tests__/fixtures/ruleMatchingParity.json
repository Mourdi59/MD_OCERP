{
  "_about": "One table, two engines. The quantity-rule sandbox (frontend ruleSandbox.ts ruleMatchesElement) and the server apply (backend BIMHubService._rule_matches_element) must select the same elements for every rule below, and read the same raw quantity for every quantity case (sandbox extractRawQuantity, server _extract_quantity; null = skipped as missing). Read by frontend/src/features/bim/__tests__/ruleMatchingParity.test.ts and backend/tests/unit/test_rule_matching_parity.py. Add a case here, not to one side.",
  "elements": [
    { "id": "wall-existing", "element_type": "Walls", "properties": { "category": "Walls", "phase created": "Stato di fatto", "type name": "Muro 30" } },
    { "id": "wall-new", "element_type": "Walls", "properties": { "category": "Walls", "phase created": "Progetto", "type name": "Muro 12" } },
    { "id": "ifc-wall", "element_type": "IfcWallStandardCase", "properties": { "category": "Walls", "phase created": "Progetto" } },
    { "id": "curtain", "element_type": "Curtain Walls", "properties": { "category": "Curtain Walls" } },
    { "id": "door", "element_type": "Doors", "properties": { "category": "Doors", "Phase Created": "Progetto", "mark": "D-01" } },
    { "id": "untyped", "element_type": "", "properties": { "phase created": "Progetto" } }
  ],
  "cases": [
    { "name": "empty filter matches every element", "rule": { "element_type_filter": "", "property_filter": {} }, "expected": ["wall-existing", "wall-new", "ifc-wall", "curtain", "door", "untyped"] },
    { "name": "star matches every element", "rule": { "element_type_filter": "*", "property_filter": {} }, "expected": ["wall-existing", "wall-new", "ifc-wall", "curtain", "door", "untyped"] },
    { "name": "single wildcard", "rule": { "element_type_filter": "Wall*", "property_filter": {} }, "expected": ["wall-existing", "wall-new"] },
    { "name": "comma list with spaces, any pattern is enough", "rule": { "element_type_filter": "Wall*, IfcWall*", "property_filter": {} }, "expected": ["wall-existing", "wall-new", "ifc-wall"] },
    { "name": "comma list is case-insensitive and ignores empty items", "rule": { "element_type_filter": " walls ,, curtain*, ", "property_filter": {} }, "expected": ["wall-existing", "wall-new", "curtain"] },
    { "name": "padded filter is trimmed", "rule": { "element_type_filter": "  Doors  ", "property_filter": {} }, "expected": ["door"] },
    { "name": "a type filter never matches an element without a type", "rule": { "element_type_filter": "*s", "property_filter": {} }, "expected": ["wall-existing", "wall-new", "curtain", "door"] },
    { "name": "property key typed as Revit spells it", "rule": { "element_type_filter": "Wall*, IfcWall*", "property_filter": { "Phase Created": "progetto" } }, "expected": ["wall-new", "ifc-wall"] },
    { "name": "property key padded and upper-cased", "rule": { "element_type_filter": "", "property_filter": { " PHASE CREATED ": "Progetto" } }, "expected": ["wall-new", "ifc-wall", "door", "untyped"] },
    { "name": "property value wildcard", "rule": { "element_type_filter": "", "property_filter": { "type name": "muro*" } }, "expected": ["wall-existing", "wall-new"] },
    { "name": "two property filters must both hold", "rule": { "element_type_filter": "", "property_filter": { "category": "Doors", "Mark": "d-*" } }, "expected": ["door"] },
    { "name": "missing property fails", "rule": { "element_type_filter": "", "property_filter": { "phase demolished": "*" } }, "expected": [] },
    { "name": "blank property key is ignored", "rule": { "element_type_filter": "Doors", "property_filter": { "  ": "anything" } }, "expected": ["door"] },
    {"name": "not equals keeps elements without the property", "rule": {"element_type_filter": "", "property_filter": {"Phase Created": {"$op": "not_equals", "value": "progetto"}}}, "expected": ["wall-existing", "curtain"]},
    {"name": "not equals honours wildcards like equals", "rule": {"element_type_filter": "", "property_filter": {"type name": {"$op": "not_equals", "value": "muro*"}}}, "expected": ["ifc-wall", "curtain", "door", "untyped"]},
    {"name": "operator form of equals is the bare form", "rule": {"element_type_filter": "", "property_filter": {"Phase Created": {"$op": "equals", "value": "progetto"}}}, "expected": ["wall-new", "ifc-wall", "door", "untyped"]},
    {"name": "is empty selects a property nobody set", "rule": {"element_type_filter": "", "property_filter": {"phase demolished": {"$op": "is_empty"}}}, "expected": ["wall-existing", "wall-new", "ifc-wall", "curtain", "door", "untyped"]},
    {"name": "is not empty selects the set ones", "rule": {"element_type_filter": "", "property_filter": {"phase created": {"$op": "is_not_empty"}}}, "expected": ["wall-existing", "wall-new", "ifc-wall", "door", "untyped"]},
    {"name": "contains is case-insensitive", "rule": {"element_type_filter": "", "property_filter": {"type name": {"$op": "contains", "value": "MURO"}}}, "expected": ["wall-existing", "wall-new"]},
    {"name": "not contains keeps elements without the property", "rule": {"element_type_filter": "", "property_filter": {"type name": {"$op": "not_contains", "value": "30"}}}, "expected": ["wall-new", "ifc-wall", "curtain", "door", "untyped"]},
    {"name": "operator and bare value combine", "rule": {"element_type_filter": "", "property_filter": {"category": "Walls", "phase created": {"$op": "not_equals", "value": "Progetto"}}}, "expected": ["wall-existing"]},
    {"name": "an unknown operator selects nothing", "rule": {"element_type_filter": "", "property_filter": {"phase created": {"$op": "between", "value": "a"}}}, "expected": []}
  ],
  "single_cases": [
    { "name": "bracket value picked from the model matches itself", "element": { "element_type": "Walls", "properties": { "type name": "Muro [30 cm]" } }, "rule": { "element_type_filter": "", "property_filter": { "type name": "Muro [30 cm]" } }, "expected": true },
    { "name": "star after a literal bracket", "element": { "element_type": "Walls", "properties": { "type name": "Muro [30 cm]" } }, "rule": { "element_type_filter": "", "property_filter": { "type name": "muro [*" } }, "expected": true },
    { "name": "brackets in a type filter are literal", "element": { "element_type": "Walls", "properties": {} }, "rule": { "element_type_filter": "[WD]*", "property_filter": {} }, "expected": false },
    { "name": "bang bracket is literal too", "element": { "element_type": "Walls", "properties": {} }, "rule": { "element_type_filter": "[!D]*", "property_filter": {} }, "expected": false },
    { "name": "star runs across a line break", "element": { "element_type": "Walls", "properties": { "comments": "riga 1\nriga 2" } }, "rule": { "element_type_filter": "", "property_filter": { "comments": "riga*" } }, "expected": true },
    { "name": "whole-number float matches integer text", "element": { "element_type": "Walls", "properties": { "width": 300.0 } }, "rule": { "element_type_filter": "", "property_filter": { "width": "300" } }, "expected": true },
    { "name": "whole-number float matches its float spelling from the value list", "element": { "element_type": "Walls", "properties": { "width": 300.0 } }, "rule": { "element_type_filter": "", "property_filter": { "width": "300.0" } }, "expected": true },
    { "name": "integer matches its float spelling too", "element": { "element_type": "Walls", "properties": { "width": 300 } }, "rule": { "element_type_filter": "", "property_filter": { "width": "300.0" } }, "expected": true },
    { "name": "float spelling with two zeros is not the value list's", "element": { "element_type": "Walls", "properties": { "width": 300.0 } }, "rule": { "element_type_filter": "", "property_filter": { "width": "300.00" } }, "expected": false },
    { "name": "decimal float matches its text", "element": { "element_type": "Walls", "properties": { "width": 0.25 } }, "rule": { "element_type_filter": "", "property_filter": { "width": "0.25" } }, "expected": true },
    { "name": "decimal float does not match a padded spelling", "element": { "element_type": "Walls", "properties": { "width": 0.3 } }, "rule": { "element_type_filter": "", "property_filter": { "width": "0.30" } }, "expected": false },
    { "name": "boolean matches true text", "element": { "element_type": "Walls", "properties": { "structural": true } }, "rule": { "element_type_filter": "", "property_filter": { "structural": "TRUE" } }, "expected": true },
    { "name": "only commas select nothing", "element": { "element_type": "Walls", "properties": {} }, "rule": { "element_type_filter": ",", "property_filter": {} }, "expected": false },
    {"name": "greater than a bare number", "element": {"element_type": "Walls", "properties": {"width": 300.0}}, "rule": {"element_type_filter": "", "property_filter": {"width": {"$op": "gt", "value": "250"}}}, "expected": true},
    {"name": "greater than is strict", "element": {"element_type": "Walls", "properties": {"width": 300.0}}, "rule": {"element_type_filter": "", "property_filter": {"width": {"$op": "gt", "value": "300"}}}, "expected": false},
    {"name": "greater or equal includes the value", "element": {"element_type": "Walls", "properties": {"width": 300}}, "rule": {"element_type_filter": "", "property_filter": {"width": {"$op": "gte", "value": "300.0"}}}, "expected": true},
    {"name": "less than across units", "element": {"element_type": "Walls", "properties": {"length": "3000 mm"}}, "rule": {"element_type_filter": "", "property_filter": {"length": {"$op": "lt", "value": "3.5 m"}}}, "expected": true},
    {"name": "less than across units, false side", "element": {"element_type": "Walls", "properties": {"length": "4000 mm"}}, "rule": {"element_type_filter": "", "property_filter": {"length": {"$op": "lt", "value": "3.5 m"}}}, "expected": false},
    {"name": "superscript unit equals its ASCII spelling", "element": {"element_type": "Walls", "properties": {"area": "12 m²"}}, "rule": {"element_type_filter": "", "property_filter": {"area": {"$op": "gte", "value": "12 m2"}}}, "expected": true},
    {"name": "square feet against square metres", "element": {"element_type": "Walls", "properties": {"area": "100 ft2"}}, "rule": {"element_type_filter": "", "property_filter": {"area": {"$op": "lt", "value": "10 m2"}}}, "expected": true},
    {"name": "a length never compares with a mass", "element": {"element_type": "Walls", "properties": {"length": "3 m"}}, "rule": {"element_type_filter": "", "property_filter": {"length": {"$op": "gt", "value": "1 kg"}}}, "expected": false},
    {"name": "a bare value reads in the other side's unit", "element": {"element_type": "Walls", "properties": {"width": 300}}, "rule": {"element_type_filter": "", "property_filter": {"width": {"$op": "gt", "value": "0.2 m"}}}, "expected": true},
    {"name": "text is not a number", "element": {"element_type": "Walls", "properties": {"width": "trenta"}}, "rule": {"element_type_filter": "", "property_filter": {"width": {"$op": "gt", "value": "1"}}}, "expected": false},
    {"name": "an unknown unit is not a number", "element": {"element_type": "Walls", "properties": {"width": "3 furlongs"}}, "rule": {"element_type_filter": "", "property_filter": {"width": {"$op": "lt", "value": "10"}}}, "expected": false},
    {"name": "a decimal comma is not a number", "element": {"element_type": "Walls", "properties": {"width": "0,30"}}, "rule": {"element_type_filter": "", "property_filter": {"width": {"$op": "lt", "value": "1"}}}, "expected": false},
    {"name": "a boolean is not a number", "element": {"element_type": "Walls", "properties": {"structural": true}}, "rule": {"element_type_filter": "", "property_filter": {"structural": {"$op": "gt", "value": "0"}}}, "expected": false},
    {"name": "a missing number does not compare", "element": {"element_type": "Walls", "properties": {}}, "rule": {"element_type_filter": "", "property_filter": {"width": {"$op": "lt", "value": "1"}}}, "expected": false},
    {"name": "any list item can satisfy a comparison", "element": {"element_type": "Walls", "properties": {"widths": [1, 5]}}, "rule": {"element_type_filter": "", "property_filter": {"widths": {"$op": "gt", "value": "4"}}}, "expected": true},
    {"name": "Revit None reads as empty", "element": {"element_type": "Walls", "properties": {"phase demolished": "None"}}, "rule": {"element_type_filter": "", "property_filter": {"phase demolished": {"$op": "is_empty"}}}, "expected": true},
    {"name": "whitespace reads as empty", "element": {"element_type": "Walls", "properties": {"comments": "   "}}, "rule": {"element_type_filter": "", "property_filter": {"comments": {"$op": "is_not_empty"}}}, "expected": false},
    {"name": "zero is a value, not empty", "element": {"element_type": "Walls", "properties": {"width": 0}}, "rule": {"element_type_filter": "", "property_filter": {"width": {"$op": "is_empty"}}}, "expected": false},
    {"name": "contains reads a number as text", "element": {"element_type": "Walls", "properties": {"mark": 1234}}, "rule": {"element_type_filter": "", "property_filter": {"mark": {"$op": "contains", "value": "23"}}}, "expected": true},
    {"name": "contains looks into list items", "element": {"element_type": "Walls", "properties": {"materials": ["Steel", "Concrete C30"]}}, "rule": {"element_type_filter": "", "property_filter": {"materials": {"$op": "contains", "value": "c30"}}}, "expected": true},
    {"name": "not contains on an empty value holds", "element": {"element_type": "Walls", "properties": {"comments": ""}}, "rule": {"element_type_filter": "", "property_filter": {"comments": {"$op": "not_contains", "value": "x"}}}, "expected": true}
  ],
  "quantity_cases": [
    { "name": "property source by its stored key", "source": "property:spessore", "element": { "properties": { "spessore": "0.30" }, "quantities": {} }, "expected": 0.3 },
    { "name": "property source in Revit case", "source": "property:Spessore", "element": { "properties": { "spessore": "0.30" }, "quantities": {} }, "expected": 0.3 },
    { "name": "property source with padding", "source": "property: SPESSORE ", "element": { "properties": { "spessore": "0.30" }, "quantities": {} }, "expected": 0.3 },
    { "name": "exact property key wins over a case variant", "source": "property:Mark", "element": { "properties": { "mark": "1", "Mark": "2" }, "quantities": {} }, "expected": 2 },
    { "name": "padded number value", "source": "property:spessore", "element": { "properties": { "spessore": " 0.30 " }, "quantities": {} }, "expected": 0.3 },
    { "name": "decimal comma is not a number", "source": "property:spessore", "element": { "properties": { "spessore": "0,30" }, "quantities": {} }, "expected": null },
    { "name": "text property is not a number", "source": "property:spessore", "element": { "properties": { "spessore": "trenta" }, "quantities": {} }, "expected": null },
    { "name": "missing property", "source": "property:spessore", "element": { "properties": {}, "quantities": {} }, "expected": null },
    { "name": "quantity key", "source": "area", "element": { "properties": {}, "quantities": { "area": 12.5 } }, "expected": 12.5 },
    { "name": "quantity key stays exact", "source": "Area", "element": { "properties": {}, "quantities": { "area": 12.5 } }, "expected": null },
    { "name": "count is one", "source": "count", "element": { "properties": {}, "quantities": {} }, "expected": 1 }
  ]
}
